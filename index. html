
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hawa.exe | My Space</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap');

:root {
    --bg: #f4f0e8;
    --black: #171717;
    --lime: #c8ff38;
    --pink: #ff83bc;
    --purple: #a995ff;
    --white: #fffdf7;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--black);
    font-family: 'Space Grotesk', sans-serif;
    background-image: radial-gradient(#0002 1px, transparent 1px);
    background-size: 10px 10px;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font: inherit;
    cursor: pointer;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

/* RUNNING TEXT */
.ticker {
    background: var(--lime);
    border-bottom: 2px solid var(--black);
    overflow: hidden;
    padding: 10px;
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
}

.ticker span {
    display: inline-block;
    animation: scrollText 20s linear infinite;
}

/* NAVBAR */
header {
    background: var(--white);
    border-bottom: 2px solid var(--black);
    position: sticky;
    top: 0;
    z-index: 10;
}

nav {
    min-height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.logo {
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -2px;
}

.logo span {
    background: var(--pink);
    padding: 2px 5px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 13px;
    font-weight: bold;
}

.nav-links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
}

.menu-btn {
    display: none;
}

.theme-btn,
.menu-btn {
    border: 2px solid var(--black);
    background: var(--white);
    padding: 8px 12px;
    box-shadow: 3px 3px 0 var(--black);
}

/* HERO */
.hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    padding-top: 75px;
    padding-bottom: 70px;
}

.status {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

.status span {
    color: #24a84a;
}

h1 {
    font-size: clamp(50px, 8vw, 90px);
    line-height: .95;
    letter-spacing: -7px;
    margin: 25px 0;
}

.highlight {
    display: inline-block;
    background: var(--lime);
    border: 2px solid var(--black);
    padding: 3px 10px 10px;
    box-shadow: 5px 5px 0 var(--black);
    transform: rotate(-2deg);
}

.hero p {
    font-size: 16px;
    line-height: 1.8;
    max-width: 480px;
}

.hero p strong {
    background: var(--pink);
}

.buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
}

.btn {
    padding: 12px 16px;
    border: 2px solid var(--black);
    background: var(--lime);
    box-shadow: 4px 4px 0 var(--black);
    font-weight: bold;
    display: inline-block;
    transition: .2s;
}

.btn:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--black);
}

.btn.pink {
    background: var(--pink);
}

/* PROFILE ART */
.art {
    min-height: 390px;
    background: var(--purple);
    border: 2px solid var(--black);
    box-shadow: 8px 8px 0 var(--black);
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    transform: rotate(2deg);
}

.art::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(#17171720 1px, transparent 1px),
        linear-gradient(90deg, #17171720 1px, transparent 1px);
    background-size: 25px 25px;
}

.avatar {
    position: relative;
    z-index: 1;
    width: 210px;
    height: 250px;
    background: var(--pink);
    border: 2px solid var(--black);
    border-radius: 45% 45% 35% 35%;
    display: grid;
    place-items: center;
    font-size: 115px;
    box-shadow: 7px 7px 0 var(--black);
    animation: float 3s ease-in-out infinite;
}

.sticker {
    position: absolute;
    z-index: 2;
    background: var(--white);
    border: 2px solid var(--black);
    padding: 8px 12px;
    box-shadow: 3px 3px 0 var(--black);
    font-size: 12px;
    font-weight: bold;
}

.sticker.one {
    top: 25px;
    left: 15px;
    transform: rotate(-8deg);
}

.sticker.two {
    bottom: 25px;
    right: 12px;
    background: var(--lime);
    transform: rotate(5deg);
}

/* SECTION */
section.content {
    padding-top: 45px;
    padding-bottom: 15px;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 25px;
    gap: 12px;
}

.eyebrow {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

h2 {
    font-size: clamp(30px, 5vw, 46px);
    letter-spacing: -2px;
    line-height: 1.1;
}

.number {
    background: var(--pink);
    border: 2px solid var(--black);
    padding: 5px 10px;
    font-size: 12px;
    font-weight: bold;
    box-shadow: 3px 3px 0 var(--black);
}

.grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 20px;
}

.card {
    background: var(--white);
    border: 2px solid var(--black);
    padding: 25px;
    box-shadow: 5px 5px 0 var(--black);
    transition: .2s;
}

.card:hover {
    transform: translateY(-5px);
}

.card h3 {
    font-size: 23px;
    margin-bottom: 12px;
}

.card p {
    font-size: 14px;
    line-height: 1.8;
}

.card-title {
    border-bottom: 1px dashed var(--black);
    padding-bottom: 12px;
    margin-bottom: 18px;
    font-size: 12px;
    font-weight: bold;
}

.info {
    display: grid;
    gap: 15px;
}

.info-item {
    display: flex;
    gap: 12px;
    align-items: center;
}

.info-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--lime);
    border: 1.5px solid var(--black);
    font-size: 20px;
}

.info-item small {
    display: block;
    font-size: 10px;
    color: #777;
}

.info-item strong {
    font-size: 14px;
}

/* EDUCATION AND HOBBIES */
.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.pink-card {
    background: var(--pink);
}

.lime-card {
    background: var(--lime);
}

.purple-card {
    background: var(--purple);
}

.year {
    display: inline-block;
    border: 1.5px solid var(--black);
    padding: 4px 8px;
    margin: 10px 0;
    font-size: 11px;
    font-weight: bold;
}

.hobbies {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.hobby {
    border: 1.5px solid var(--black);
    padding: 12px;
    background: var(--pink);
}

.hobby:nth-child(2) {
    background: var(--lime);
}

.hobby:nth-child(3) {
    background: var(--purple);
}

.hobby:nth-child(4) {
    background: var(--white);
}

.hobby span {
    font-size: 25px;
}

.hobby p {
    font-weight: bold;
    font-size: 12px;
}

/* SKILLS */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.skill {
    border: 1.5px solid var(--black);
    background: var(--lime);
    padding: 7px 10px;
    font-size: 12px;
    font-weight: bold;
}

.skill:nth-child(even) {
    background: var(--pink);
}

/* MOTIVATION */
.manifesto {
    margin-top: 65px;
    padding: 35px;
    background: var(--lime);
    border: 2px solid var(--black);
    box-shadow: 7px 7px 0 var(--black);
}

.manifesto .big {
    font-size: clamp(38px, 7vw, 68px);
    font-weight: bold;
    letter-spacing: -4px;
    line-height: 1;
    margin: 20px 0;
}

.manifesto p {
    max-width: 550px;
    line-height: 1.8;
}

/* CONTACT */
.contact {
    margin-top: 65px;
    margin-bottom: 35px;
    padding: 30px;
    background: var(--pink);
    border: 2px solid var(--black);
    box-shadow: 7px 7px 0 var(--black);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.contact p {
    margin-top: 10px;
}

footer {
    padding: 20px 0 30px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 11px;
    font-weight: bold;
}

/* DARK MODE */
body.dark {
    --bg: #151515;
    --black: #f7f3e8;
    --white: #222;
    color: #f7f3e8;
}

body.dark .ticker,
body.dark .highlight,
body.dark .manifesto,
body.dark .info-icon,
body.dark .skill,
body.dark .lime-card {
    color: #171717;
}

body.dark .nav-links a {
    color: #171717;
}

body.dark .card p {
    color: #dedede;
}

body.dark .hobby:nth-child(4) {
    background: #222;
}

/* ANIMATIONS */
@keyframes float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-12px) rotate(3deg); }
}

@keyframes scrollText {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

/* RESPONSIVE */
@media (max-width: 800px) {
    .hero {
        grid-template-columns: 1fr;
        padding-top: 45px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .cards {
        grid-template-columns: 1fr 1fr;
    }

    .cards > :last-child {
        grid-column: 1 / -1;
    }
}

@media (max-width: 600px) {
    nav {
        flex-wrap: wrap;
        padding: 12px 0;
    }

    .menu-btn {
        display: block;
        margin-left: auto;
    }

    .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        padding: 15px 0;
    }

    .nav-links.open {
        display: flex;
    }

    h1 {
        letter-spacing: -4px;
    }

    .art {
        min-height: 320px;
    }

    .avatar {
        width: 180px;
        height: 215px;
        font-size: 95px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .cards > :last-child {
        grid-column: auto;
    }

    .contact {
        align-items: flex-start;
        flex-direction: column;
    }

    .manifesto {
        padding: 25px 20px;
    }
}
</style>
</head>

